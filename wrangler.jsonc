{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "second-brain-mcp",
  "main": "src/main/worker.ts",
  "compatibility_date": "2026-11-19",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "second-brain",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "queues": {
    "producers": [{ "binding": "INDEX_QUEUE", "queue": "second-brain-index" }],
    "consumers": [
      {
        "queue": "second-brain-index",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "second-brain-index-dlq",
      },
    ],
  },
  "triggers": { "crons": ["17 4 * * *"] },
}
